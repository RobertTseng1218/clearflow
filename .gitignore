# =========================
# ClearFlow .gitignore
# =========================

# Python
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/

# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Local database / runtime data
*.db
*.sqlite
*.sqlite3
apps/api/clearflow.db

# Logs
*.log
logs/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Misc
*.tmp
*.temp
